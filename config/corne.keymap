#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define CM   1
#define NOMOd 2
#define LOWER  3
#define RAISE   4
#define ML   5

// Key positions, for positional hold-tap on the home row mods.
//   row 0   0..11      row 1  12..23      row 2  24..35      thumbs 36..41
#define KEYS_L  0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick_tap_ms = <200>; };

/ {
    behaviors {
        // Positional hold-tap. A home row mod only becomes a modifier when
        // the next key is on the *other* hand; a same-hand roll resolves to a
        // tap immediately. That removes the reason the timings had to be
        // defensive, so the flavor can be quick instead of slow:
        //   balanced             - a hold resolves as soon as the interrupting
        //                          key is released, rather than always waiting
        //                          out the full tapping term
        //   hold-trigger-on-release - defer the same-hand check until release,
        //                          so two mods on one hand still chord
        //   require-prior-idle   - pressed <150ms after another key it is a
        //                          tap instantly, so speed typing can't misfire
        //   quick-tap 175        - re-tapping the same key stays a tap

        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SQT>, <&kp SEMI>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&kp ESCAPE>;
        };

        caps_word: caps_word {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS_WORD";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
   
        tri_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    macros {
        win_sleep: win_sleep {
            label = "win_sleep";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LG(X) &kp U &kp S>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Mirrored ring+middle pairs, opening on the left, closing on the right:
        //   row0   W+F -> [     U+Y -> ]
        //   row1   R+S -> (     E+I -> )
        //   row2   X+C -> {     ,+. -> }

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <0>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <14 15>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <26 27>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9>;
            layers = <0>;
        };

        right_para {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 33>;
            layers = <0>;
        };

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_layer {
            display-name = "Colemak";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  ;  | BKSP |
            // | CTRL |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  |  '   |
            // | SHFT |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | SHFT |
            //                    | GUI |     | SPC |   | ENT |      | ALT |
            //
            // Home row mods (hold), mirrored pinky -> index.
            // Right pinky is plain O; RCTRL lives on / instead.
            //         CTRL SHFT ALT  GUI              GUI  ALT  SHFT  --
            //          A    R    S    T                N    E    I    O

            bindings = <
&trans  &td0          &kp W         &kp F        &kp P        &kp B          &kp J    &kp L            &kp U        &kp Y         &td1             &trans
&trans  &hml LCTRL A  &hml LSHFT R  &hml LALT S  &hml LGUI T  &kp G          &kp M    &hmr RGUI N      &hmr RALT E  &hmr RSHFT I  &kp O            &trans
&trans  &kp Z         &kp X         &kp C        &kp D        &kp V          &kp K    &kp H            &kp COMMA    &kp DOT       &hmr RCTRL FSLH  &trans
                                    &trans       &lt 1 TAB    &kp SPACE      &kp RET  &lt 2 BACKSPACE  &mo 3
            >;
        };

        lower_layer {
            display-name = "Num/Nav";

            // -----------------------------------------------------------------------------------------
            // |   `  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // |      |     |     |     |     |     |   | LFT | DWN |  UP | RGT |  _  |   +  |
            // | SHFT |     |     |     |     |     |   |     |  -  |  =  |     |  \  | SHFT |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp N1     &kp N2     &kp N3            &kp N4        &kp N5                 &kp N6       &kp N7       &kp N8      &kp N9     &kp N0         &trans
&trans  &kp GRAVE  &kp EQUAL  &kp GREATER_THAN  &kp PLUS      &kp MINUS              &kp LEFT     &kp DOWN     &kp UP      &kp RIGHT  &kp UNDER      &trans
&trans  &kp TILDE  &kp HASH   &kp LESS_THAN     &kp ASTERISK  &kp EXCL  &kp AT_SIGN  &kp PERCENT  &kp DOLLAR  &kp PIPE   &kp BACKSLASH  &trans
                              &trans            &trans        &trans                 &kp ESC      &trans       &trans
            >;
        };

        raise_layer {
            display-name = "Func";

            // -----------------------------------------------------------------------------------------
            // | ESC |  F2 |  F3  |  F4 |  F5 |  F6 |   | F7  |  F8 |  F9 | F10 | F11 | F12 | 
            // | F1  |     |      | DEL | HOME| END |   | PRT |     |     |     |     |     |
            // | SHFT |     |     |     | Vdwn|V_up |   |     |     |     |     |     | slp |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F2  &kp F3     &kp F4       &kp F5  &kp F6      &kp F7    &kp F8     &kp F9     &kp F10  &kp F11     &trans
&trans  &kp F1  &kp PSCRN  &kp DEL      &trans  &trans      &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp F12     &trans
&trans  &trans  &trans     &trans       &trans  &trans      &trans    &trans     &trans     &trans   &kp RC(F5)  &trans
                           &kp LG(TAB)  &trans  &caps_word  &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LG(LEFT)) LC(LG(RIGHT))>;
        };

        layer_4 {
            display-name = "Media";

            bindings = <
&trans  &kp K_MUTE  &kp K_VOL_DN  &kp K_VOL_UP  &kp PSCRN   &trans             &trans                &trans                &trans              &trans                 &trans  &trans
&trans  &trans      &trans        &trans        &kp LC(LG(LEFT))  &kp LC(RG(RIGHT))  &kp LS(LC(LG(LEFT)))  &kp LS(LC(LG(DOWN)))  &kp LS(LC(LG(UP)))  &kp LS(LC(LG(RIGHT)))  &trans  &trans
&trans  &trans      &trans        &trans        &trans            &trans             &kp LS(LG(LEFT))  &kp LS(LG(DOWN))  &kp LS(LG(UP))  &kp LS(LG(RIGHT))  &trans  &trans
                                  &trans        &trans            &trans             &trans                &trans                &trans
            >;
        };
    };
};
